# Copy to .env and fill in. Keep .env private: the token controls your bot.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Telegram user ids allowed to use the bot (comma separated). Message the bot
# once and it replies with your id. Everyone else is ignored.
ALLOWED_USER_IDS=

# Optional: only accept group messages from these chat ids (forum groups start with -100)
ALLOWED_CHAT_IDS=

# Folder new topics start in (change per topic with /cwd or /topic Name | folder)
DEFAULT_CWD=~/code

# Where state.json and downloaded attachments live
DATA_DIR=~/.claude-telegram

# Path to the Claude Code CLI if it is not on PATH (e.g. ~/.local/bin/claude)
CLAUDE_BIN=claude

# Nobody can click "Allow" from Telegram, so choose what Claude may do on its own:
#   acceptEdits        edit files; other tools only if listed in ALLOWED_TOOLS (safest useful default)
#   auto               a classifier approves safe actions and blocks risky ones
#   plan               read-only, proposes plans
#   bypassPermissions  anything, no checks (only on a throwaway VM/container; refused when running as root)
PERMISSION_MODE=acceptEdits

# Extra tools to pre-approve, space separated (quote entries with spaces)
ALLOWED_TOOLS="Bash(git status:*) Bash(git diff:*) Bash(git log:*) Bash(ls:*) WebSearch WebFetch"

# Optional default model (opus, sonnet, haiku or a full model id); /model overrides per topic
CLAUDE_MODEL=

# Extra flags passed to every claude run, e.g. --max-budget-usd 2
CLAUDE_EXTRA_ARGS=

# 1 = show a live "what Claude is doing" status message, 0 = only final replies
SHOW_PROGRESS=1

LOG_LEVEL=INFO
